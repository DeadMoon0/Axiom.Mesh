<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The integration suite: real nodes on loopback sockets with real TLS, a store and an index on disk per node, the real
    pipe in front of each node's local port, and the real command line over it. It runs the scenario suite the in-memory
    suite runs, from the very same source file, plus what only an operating system can show (pipe access lists, socket
    modes, peer credentials) and the release floors (AXIOM_MESH_FLOORS=1, Release only).
  -->
  <PropertyGroup>
    <RootNamespace>Axiom.Mesh.Integration.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Axiom.Mesh.Testing\Axiom.Mesh.Testing.csproj" />
    <ProjectReference Include="..\..\Axiom.Mesh.Host\Axiom.Mesh.Host.csproj" />
    <ProjectReference Include="..\..\Apps\Axiom.Mesh.Cli\Axiom.Mesh.Cli.csproj" />
    <!-- The chat service, run in process over the real pipe (SocketChatScenarios) and spawned by a real Host as its own
         program from the apphost the build puts beside its assembly (ChatProcessTests). -->
    <ProjectReference Include="..\..\Services\Axiom.Mesh.Chat\Axiom.Mesh.Chat.csproj" />
    <!-- The sync service, run in process over the real pipe (SocketSyncScenarios, SyncFloorTests). -->
    <ProjectReference Include="..\..\Services\Axiom.Mesh.Sync\Axiom.Mesh.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scenario suites, unchanged: the same files the in-memory suites compile (MeshScenarios, plan §5; ChatScenarios, plan §9.3). -->
    <Compile Include="..\..\UnitTests\Axiom.Mesh.Testing.Tests\Rules\MeshScenarios.cs" Link="Rules\MeshScenarios.cs" />
    <Compile Include="..\..\UnitTests\Services\Axiom.Mesh.Chat.Tests\Rules\ChatScenarios.cs" Link="Rules\ChatScenarios.cs" />
    <Compile Include="..\..\UnitTests\Services\Axiom.Mesh.Sync.Tests\Rules\SyncScenarios.cs" Link="Rules\SyncScenarios.cs" />
  </ItemGroup>

</Project>
