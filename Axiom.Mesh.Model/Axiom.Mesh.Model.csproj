<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Title>Axiom.Mesh.Model</Title>
    <Authors>DeadMoon0</Authors>
    <Product>Axiom</Product>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Axiom;Mesh;p2p;lan;content-addressed;signing;replication</PackageTags>
    <PackageIcon>Icon.png</PackageIcon>
    <Description>Part of the Axiom family. The honest core of Axiom.Mesh: ids, objects, Entries and their signatures, the history's order and the rules that decide what is valid, as pure functions with no socket, disk or clock.</Description>
    <Version>0.2.0</Version>
    <PackageProjectUrl>https://github.com/DeadMoon0/Axiom.Mesh</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DeadMoon0/Axiom.Mesh.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) DeadMoon0 2026</Copyright>
    <!-- The package and assembly are Axiom.Mesh.Model; the namespace is Axiom.Mesh, the root every other package builds on. -->
    <RootNamespace>Axiom.Mesh</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package's own test project, and nobody else. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Axiom.Mesh.Model.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- WireReader and WireWriter for the encodings of SPEC.md §5.2; nothing else of ProtoStream. -->
    <PackageReference Include="Axiom.ProtoStream" />
  </ItemGroup>

</Project>
