<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The spikes restore the published Axiom packages from nuget.org only; machine-level feeds must not leak in. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
