<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Title>Axiom.Mesh.Protocol</Title>
    <Authors>DeadMoon0</Authors>
    <Product>Axiom</Product>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Axiom;Mesh;p2p;protocol;protostream;tls</PackageTags>
    <PackageIcon>Icon.png</PackageIcon>
    <Description>Part of the Axiom family. AMP/1, the mesh wire protocol of Axiom.Mesh, described with Axiom.ProtoStream: its messages, session states, limits and the pure rules a session checks, and the pairing protocol.</Description>
    <Version>0.1.0</Version>
    <PackageProjectUrl>https://github.com/DeadMoon0/Axiom.Mesh</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DeadMoon0/Axiom.Mesh.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) DeadMoon0 2026</Copyright>
    <PackageReleaseNotes>AMP/1: the sixteen messages with every bound of SPEC.md §7, the frame codec (unknown ids 17 to 255 ignored), the session definition (states, timeouts, heartbeat, violation replies), HelloRule, ListingRule, WantBudget and ObjectQueueRule; ObjectMessage.FromStored, which sends an object read back from the sender's own store as it is; the pairing protocol axiom-mesh-pair/1 of PAIR-SPEC.md: messages, definition, code, SAS, checks and state machine.</PackageReleaseNotes>
    <RootNamespace>Axiom.Mesh.Protocol</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package's own test project, and nobody else. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Axiom.Mesh.Protocol.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Axiom.Mesh.Model\Axiom.Mesh.Model.csproj" />
    <PackageReference Include="Axiom.ProtoStream" />
  </ItemGroup>

</Project>
