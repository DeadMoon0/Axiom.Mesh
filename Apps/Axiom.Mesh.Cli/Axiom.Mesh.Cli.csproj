<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>axiom-mesh</ToolCommandName>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Title>Axiom.Mesh.Cli</Title>
    <Authors>DeadMoon0</Authors>
    <Product>Axiom</Product>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Axiom;Mesh;cli;tool</PackageTags>
    <PackageIcon>Icon.png</PackageIcon>
    <Description>Part of the Axiom family. axiom-mesh, the command line of Axiom.Mesh: a user client of the local protocol that explains every failure in one line.</Description>
    <Version>0.1.0</Version>
    <PackageProjectUrl>https://github.com/DeadMoon0/Axiom.Mesh</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DeadMoon0/Axiom.Mesh.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) DeadMoon0 2026</Copyright>
    <RootNamespace>Axiom.Mesh.Cli</RootNamespace>
  </PropertyGroup>

  <!--
    The published executable is named for the user, the assembly for the layering conventions (STRUCTURAL-DEBT.md 13):
    a Native AOT publish writes axiom-mesh, the tool command is axiom-mesh; every other build keeps Axiom.Mesh.Cli.
  -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <TargetName>axiom-mesh</TargetName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package's own test project, and nobody else. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Axiom.Mesh.Cli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <!-- ILCompiler 10.0.10 fails generating Dictionary<long, __Canon>.CopyTo (reached through ProtoStream's message set
         codec) from a generic dictionary layout its IL scanner precomputed; without the scanner it compiles.
         STRUCTURAL-DEBT.md 47: remove once the ILCompiler is fixed. -->
    <IlcArg Include="--noscan" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Axiom.Mesh.Local\Axiom.Mesh.Local.csproj" />
  </ItemGroup>

</Project>
