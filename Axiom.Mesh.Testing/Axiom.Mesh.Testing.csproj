<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Title>Axiom.Mesh.Testing</Title>
    <Authors>DeadMoon0</Authors>
    <Product>Axiom</Product>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Axiom;Mesh;testing;in-memory;fake-clock</PackageTags>
    <PackageIcon>Icon.png</PackageIcon>
    <Description>Part of the Axiom family. An in-memory Axiom.Mesh of any number of nodes for tests: fake clock, fake discovery, in-memory store and pipe, scripted peers and the CLI run in-process.</Description>
    <Version>0.2.0</Version>
    <PackageProjectUrl>https://github.com/DeadMoon0/Axiom.Mesh</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DeadMoon0/Axiom.Mesh.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) DeadMoon0 2026</Copyright>
    <RootNamespace>Axiom.Mesh.Testing</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package's own test project, and nobody else. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Axiom.Mesh.Testing.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Axiom.Mesh.Core\Axiom.Mesh.Core.csproj" />
    <!-- Services run in process beside a node (TestNode.RunServiceAsync, TestEchoService). -->
    <ProjectReference Include="..\Axiom.Mesh.Service\Axiom.Mesh.Service.csproj" />
    <!--
      The command line, run in-process against a node (TestNode.CliAsync). Its package is a dotnet tool, which no package
      can depend on, so its assembly travels inside this package (IncludeCliInPackage below); its own dependencies
      (Axiom.Mesh.Local) are this package's already.
    -->
    <ProjectReference Include="..\Apps\Axiom.Mesh.Cli\Axiom.Mesh.Cli.csproj" PrivateAssets="all" />
    <!-- What the command line inside this package references beyond Local: the chat and sync namespaces' Client libraries (packages). -->
    <ProjectReference Include="..\Services\Axiom.Mesh.Chat.Client\Axiom.Mesh.Chat.Client.csproj" />
    <ProjectReference Include="..\Services\Axiom.Mesh.Sync.Client\Axiom.Mesh.Sync.Client.csproj" />
    <!-- The in-memory database every node of a mesh runs on. -->
    <PackageReference Include="Axiom.LDB.Core" />
    <!-- One fake clock per mesh, wired into every node's server, sessions and database. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeCliInPackage</TargetsForTfmSpecificBuildOutput>
    <!-- IncludeCliInPackage resolves the references again while packing; with &#45;&#45;no-build that must not build them (NETSDK1085). -->
    <BuildProjectReferences Condition="'$(NoBuild)' == 'true'">false</BuildProjectReferences>
  </PropertyGroup>

  <Target Name="IncludeCliInPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'Axiom.Mesh.Cli' and ('%(ReferenceCopyLocalPaths.Extension)' == '.dll' or '%(ReferenceCopyLocalPaths.Extension)' == '.xml')" />
    </ItemGroup>
  </Target>

</Project>
