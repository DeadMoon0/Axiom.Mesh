root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

[*.{cs,vb}]
indent_style = space
indent_size = 4

# IDE0049: Simplify Names
dotnet_style_predefined_type_for_member_access = false

# IDE0005: Remove unnecessary usings. A warning, so TreatWarningsAsErrors makes it an error in every library build.
dotnet_diagnostic.IDE0005.severity = warning

[*.{csproj,props,targets,slnx,xml,config}]
indent_style = space
indent_size = 2

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2
