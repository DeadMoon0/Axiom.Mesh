<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Axiom.Mesh.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Axiom.Mesh.Model\Axiom.Mesh.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Round trips at every byte split and mutation fuzzing of the object decoder. -->
    <PackageReference Include="Axiom.ProtoStream.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The published test identities live in Axiom.Mesh.Testing; Model's suite compiles the one file, not the package above it. -->
    <Compile Include="..\..\Axiom.Mesh.Testing\TestKeys.cs" Link="Support\TestKeys.cs" />
    <Using Include="Axiom.Mesh.Testing" />
  </ItemGroup>

</Project>
