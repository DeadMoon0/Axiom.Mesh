<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Title>Axiom.Mesh.Core</Title>
    <Authors>DeadMoon0</Authors>
    <Product>Axiom</Product>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Axiom;Mesh;p2p;replication;store;tls;lwse;ldb</PackageTags>
    <PackageIcon>Icon.png</PackageIcon>
    <Description>Part of the Axiom family. The engine of an Axiom.Mesh node: the object store and its index, trust (rosters, grants), mutual TLS pinned to the rosters, replication, pins and eviction, and the local port the pipe's clients reach.</Description>
    <Version>0.2.0</Version>
    <PackageProjectUrl>https://github.com/DeadMoon0/Axiom.Mesh</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DeadMoon0/Axiom.Mesh.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) DeadMoon0 2026</Copyright>
    <RootNamespace>Axiom.Mesh.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package's own test project, and the benchmark suite (ConventionTests.InternalsAreOpenToTheOwnTestAssemblyOnly). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Axiom.Mesh.Core.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- The benchmark suite measures the store writer, the object store and the index directly (plan §5); it ships nothing. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Axiom.Mesh.Benchmarks</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Axiom.Mesh.Model\Axiom.Mesh.Model.csproj" />
    <ProjectReference Include="..\Axiom.Mesh.Protocol\Axiom.Mesh.Protocol.csproj" />
    <ProjectReference Include="..\Axiom.Mesh.Local\Axiom.Mesh.Local.csproj" />
    <ProjectReference Include="..\Axiom.Mesh.Discovery\Axiom.Mesh.Discovery.csproj" />
    <PackageReference Include="Axiom.ProtoStream" />
    <!-- The store index. -->
    <PackageReference Include="Axiom.LDB.Entity" />
    <!-- The server: the mesh port, the adopt-only outbound and local ports, admission, observers and drain. -->
    <PackageReference Include="Axiom.LWSE.Core" />
    <!-- Source-generated log messages. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Bcl.Cryptography" />
  </ItemGroup>

</Project>
