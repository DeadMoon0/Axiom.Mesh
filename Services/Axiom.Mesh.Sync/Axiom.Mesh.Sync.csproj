<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Title>Axiom.Mesh.Sync</Title>
    <Authors>DeadMoon0</Authors>
    <Product>Axiom</Product>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Axiom;Mesh;sync;service</PackageTags>
    <PackageIcon>Icon.png</PackageIcon>
    <Description>Part of the Axiom family. axiom-mesh-sync, the sync service of Axiom.Mesh: a folder bound to an Archive, published as Versions and kept in step both ways with the branch merges of SPEC.md §9.5, offered to every app as the namespace axiom-mesh-sync/1.</Description>
    <Version>0.2.0</Version>
    <!-- The service ships as a GitHub Release asset beside axiom-meshd (Native AOT, one zip per platform), never as a NuGet package (S-D1, fundamentals plan §6e). -->
    <IsPackable>false</IsPackable>
    <PackageProjectUrl>https://github.com/DeadMoon0/Axiom.Mesh</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DeadMoon0/Axiom.Mesh.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) DeadMoon0 2026</Copyright>
    <RootNamespace>Axiom.Mesh.Sync</RootNamespace>
  </PropertyGroup>

  <!--
    The published executable is named for the Host's default configuration (S-D11), the assembly for the layering
    conventions: a Native AOT publish writes axiom-mesh-sync; every other build keeps Axiom.Mesh.Sync.
  -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <TargetName>axiom-mesh-sync</TargetName>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <!-- The ILCompiler 10.0.10 crash of the command line and the chat service (Dictionary<long, __Canon>.CopyTo, reached
         through ProtoStream's message set codec in LocalClient) appears here too; without the IL scanner it compiles.
         STRUCTURAL-DEBT.md 47. -->
    <IlcArg Include="--noscan" />
  </ItemGroup>

  <ItemGroup>
    <!-- The service's own test project, and the benchmark suite, which measures the rules directly (plan §9.4 item 6). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Axiom.Mesh.Sync.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Axiom.Mesh.Benchmarks</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Axiom.Mesh.Service\Axiom.Mesh.Service.csproj" />
    <ProjectReference Include="..\Axiom.Mesh.Sync.Client\Axiom.Mesh.Sync.Client.csproj" />
    <!-- Bindings, fingerprints, the Version DAG, conflicts and puts (DESIGN.md §13, S-D2), in the service's own database. -->
    <PackageReference Include="Axiom.LDB.Entity" />
    <PackageReference Include="Axiom.LDB.Query" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
