<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Title>Axiom.Mesh.Discovery</Title>
    <Authors>DeadMoon0</Authors>
    <Product>Axiom</Product>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Axiom;Mesh;discovery;mdns;dns-sd;broadcast;lan</PackageTags>
    <PackageIcon>Icon.png</PackageIcon>
    <Description>Part of the Axiom family. Finding Axiom.Mesh nodes on a local network: DNS-SD over mDNS, UDP broadcast and static peers, as pure codecs with thin socket shells. A hint, never trusted; usable alone.</Description>
    <Version>0.1.0</Version>
    <PackageProjectUrl>https://github.com/DeadMoon0/Axiom.Mesh</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DeadMoon0/Axiom.Mesh.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) DeadMoon0 2026</Copyright>
    <PackageReleaseNotes>Skeleton: the DNS-SD service type.</PackageReleaseNotes>
    <RootNamespace>Axiom.Mesh.Discovery</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package's own test project, and nobody else. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Axiom.Mesh.Discovery.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Axiom.Mesh.Model\Axiom.Mesh.Model.csproj" />
  </ItemGroup>

</Project>
